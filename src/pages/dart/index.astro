---
// Vorstellung der Dart-Abteilung im normalen ASV-Design – der Knopf führt in den eigenen Dart-Bereich.
import Basis from '../../layouts/Basis.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import dart from '../../data/dart.json';
import { url } from '../../lib/utils';
---
<Basis titel={dart.titel} beschreibung={dart.untertitel}>
  <SeitenKopf dachzeile="Abteilung" titel={dart.titel} beschreibung={dart.untertitel} bild={dart.bild || undefined} />

  <section class="abschnitt">
    <div class="container">
      <div class="inhalt">
        <p class="einleitung">{dart.einleitung}</p>
        <div class="teams">
          {dart.teams.map((t) => (
            <div class:list={['team', `team--${t.farbe}`]}>
              {(t.logoHell || t.logo) ? <img class="team__logo" src={url(t.logoHell || t.logo)} alt="" width="872" height="850" /> : <span class="team__kuerzel">{t.kuerzel}</span>}
              <div>
                <p class="team__name">{t.name}</p>
                <p class="leise">{t.liga} · Training {t.training}</p>
              </div>
            </div>
          ))}
        </div>
        <a class="knopf knopf--dart" href={url('/dart/abteilung/')}>Zur Dart-Abteilung →</a>
      </div>
    </div>
  </section>
</Basis>

<style>
  .inhalt { max-width: 52rem; }
  .einleitung { font-size: 1.25rem; margin: 0 0 2rem; }
  .teams { display: grid; gap: 1rem; margin-bottom: 2rem; }
  @media (min-width: 640px) { .teams { grid-template-columns: 1fr 1fr; } }
  .team { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.25rem; background: var(--weiss); border-radius: var(--radius); box-shadow: var(--schatten); }
  .team p { margin: 0; }
  .team__kuerzel { display: grid; place-items: center; flex: none; width: 3.25rem; height: 3.25rem; border-radius: 50%; color: #fff; font-family: var(--schrift-titel); font-weight: 700; font-size: 1.2rem; }
  .team__logo { width: 3.6rem; height: auto; flex: none; }
  .team--rot .team__kuerzel { background: #e3262b; }
  .team--gruen .team__kuerzel { background: #1a9e4b; }
  .team__name { font-family: var(--schrift-titel); font-weight: 700; font-size: 1.4rem; }
  .knopf--dart { background: #111; }
  .knopf--dart:hover { background: #e3262b; }
</style>
