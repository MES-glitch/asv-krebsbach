---
import DartBasis from '../../../layouts/DartBasis.astro';
import Dartscheibe from '../../../components/dart/Dartscheibe.astro';
import dart from '../../../data/dart.json';
import TeamReiter from '../../../components/dart/TeamReiter.astro';
import { url } from '../../../lib/utils';
import { ladeLiga, spielDatum, spielZeit } from '../../../lib/dart-liga';

export function getStaticPaths() {
  return dart.teams.map((team) => ({ params: { team: team.id }, props: { team } }));
}
const { team } = Astro.props;
const anderes = dart.teams.find((t) => t.id !== team.id);
const liga = await ladeLiga(team.eventId, team.participantId);
// Kader aus dem 3K-Portal; Spitznamen, Rollen und Steckbriefe kommen aus dem Redaktionsbereich (Abgleich über den Namen)
const extra = new Map(team.spieler.map((s: any) => [s.name, s]));
const rang = (k: { captain: boolean; coCaptain: boolean }) => (k.captain ? 0 : k.coCaptain ? 1 : 2);
const spieler = liga?.kader.length
  ? [...liga.kader].sort((a, b) => rang(a) - rang(b) || a.name.localeCompare(b.name, 'de')).map((k) => {
      const e: any = extra.get(k.name) ?? {};
      return { ...e, name: k.name, spitzname: e.spitzname ?? '', rolle: e.rolle || (k.captain ? 'Kapitän' : k.coCaptain ? '2. Kapitän' : '') };
    })
  : team.spieler;
const naechstes = liga?.spiele.find((s) => !s.fertig);
const platz = liga?.tabelle.find((z) => z.id === liga.participantId);
---
<DartBasis titel={team.name} beschreibung={team.slogan} thema={team.thema}>
  <section class:list={['held', `held--${team.farbe}`]}>
    <Dartscheibe class="held__scheibe" zahlen={false} />
    <div class="d-container held__innen">
      <div class="held__marke">
        {team.logo ? <img class="held__logo" src={url(team.logo)} alt={`Logo ${team.name}`} width="872" height="850" /> : (
          <div class="held__platzhalter"><span>{team.kuerzel}</span><small>Logo folgt</small></div>
        )}
      </div>
      <div>
        <span class="d-label">{team.liga}</span>
        <h1>{team.name}</h1>
        <p class="held__slogan">„{team.slogan}“</p>
        <div class="held__reiter"><TeamReiter team={team} aktiv="team" /></div>
      </div>
    </div>
  </section>
  <div class="d-kante"></div>
  {team.bild && (
    <figure class="d-container teamfoto">
      <img src={url(team.bild)} alt={`Mannschaftsfoto ${team.name}`} />
    </figure>
  )}

  <section class:list={['d-container', 'inhalt', `inhalt--${team.farbe}`]}>
    <div class="ueber">
      <span class="d-label">Das Team</span>
      {team.beschreibung && <p>{team.beschreibung}</p>}
      <dl>
        <div><dt>Liga</dt><dd>{team.liga}{liga && ` · Gruppe ${liga.gruppe} · ${liga.dartart}`}</dd></div>
        {platz && <div><dt>Tabellenplatz</dt><dd>{platz.platz} mit {platz.punkte} Punkten</dd></div>}
        {naechstes && <div><dt>Nächstes Spiel</dt><dd>{spielDatum(naechstes.datum)}, {spielZeit(naechstes.datum)} Uhr: {naechstes.heim} – {naechstes.gast}<br /><a href={url(`/dart/${team.id}/spielplan/`)}>Zum Spielplan →</a></dd></div>}
        <div><dt>Heimspielort</dt><dd>{dart.spielort}</dd></div>
        <div><dt>Training</dt><dd>{team.training}</dd></div>
      </dl>
    </div>

    <div>
      <span class="d-label">Line-up</span>
      <h2>Die Spieler</h2>
      <ol class="spieler">
        {spieler.map((s: any, i: number) => (
          <li>
            <span class="spieler__nr">{String(i + 1).padStart(2, '0')}</span>
            {s.foto ? (
              <button type="button" class="spieler__name spieler__knopf" data-steckbrief={`sb-${i}`} aria-haspopup="dialog">
                {s.name}{s.spitzname && <em> „{s.spitzname}“</em>}<span class="spieler__icon" aria-hidden="true">Steckbrief ↗</span>
              </button>
            ) : (
              <span class="spieler__name">{s.name}{s.spitzname && <em> „{s.spitzname}“</em>}</span>
            )}
            {s.rolle && <span class="spieler__rolle">{s.rolle}</span>}
          </li>
        ))}
      </ol>
      {spieler.some((s: any) => s.foto) && <p class="spieler__hinweis">Auf einen Namen tippen, um den Steckbrief zu öffnen.</p>}
    </div>
  </section>

  {spieler.map((s: any, i: number) => s.foto && (
    <dialog class:list={['steckbrief', `steckbrief--${team.farbe}`]} id={`sb-${i}`} aria-label={`Steckbrief ${s.name}`}>
      <button type="button" class="steckbrief__zu" aria-label="Schließen">✕</button>
      <div class="steckbrief__innen">
        <img src={url(s.foto)} alt={`Steckbrief ${s.name}`} loading="lazy" width="900" height="1350" />
        <div class="steckbrief__text">
          {s.rolle && <span class="d-label">{s.rolle}</span>}
          <h3>{s.name}</h3>
          {s.spitzname && <p class="steckbrief__spitz">„{s.spitzname}“</p>}
          <dl>
            {s.dartsSeit && <div><dt>Darts seit</dt><dd>{s.dartsSeit}</dd></div>}
            {s.lieblingsdoppel && <div><dt>Lieblingsdoppel</dt><dd>{s.lieblingsdoppel}</dd></div>}
            {s.lieblingszahl && <div><dt>Lieblingszahl</dt><dd>{s.lieblingszahl}</dd></div>}
            {s.lieblingsgetraenk && <div><dt>Lieblingsgetränk</dt><dd>{s.lieblingsgetraenk}</dd></div>}
            {s.erfolge && <div><dt>Sportliche Erfolge</dt><dd>{s.erfolge}</dd></div>}
            {s.info && <div><dt>Besonderes</dt><dd>{s.info}</dd></div>}
          </dl>
        </div>
      </div>
    </dialog>
  ))}

  {anderes && (
    <section class="d-container weiter">
      <p>Auch im Vereinsheim zu Hause:</p>
      <a class:list={['d-knopf', { 'd-knopf--gruen': anderes.farbe === 'gruen' }]} href={url(`/dart/${anderes.id}/`)}>{anderes.name} →</a>
    </section>
  )}
</DartBasis>

<style>
  .held { position: relative; overflow: hidden; padding: 4rem 0; --akzent: var(--d-rot); }
  .held--gruen { --akzent: var(--d-gruen); }
  :global(.held__scheibe) { position: absolute; left: -16rem; bottom: -16rem; width: 34rem; max-width: none; opacity: 0.18; transform: rotate(12deg); }
  .held__innen { position: relative; display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .held__innen { grid-template-columns: auto 1fr; gap: 3.5rem; } }
  .held .d-label { color: var(--akzent); }
  .held h1 { font-size: clamp(2.6rem, 11.5vw, 8.5rem); margin: 0.75rem 0 1rem; }
  .held__reiter { margin-top: 2rem; }
  .held__logo { display: block; width: clamp(10rem, 24vw, 17rem); height: auto; filter: drop-shadow(0 16px 30px rgb(0 0 0 / 0.6)); }
  .teamfoto { margin-top: 3rem; }
  .teamfoto img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: center 45%; clip-path: polygon(0 0, calc(100% - 48px) 0, 100% 48px, 100% 100%, 48px 100%, 0 calc(100% - 48px)); }
  dd a { color: var(--d-sisal); }
  .held__slogan { font-size: 1.5rem; font-style: italic; color: var(--d-sisal); margin: 0; border-left: 6px solid var(--akzent); padding-left: 1rem; }
  .held__platzhalter {
    width: clamp(10rem, 24vw, 17rem); aspect-ratio: 1;
    clip-path: polygon(0 0, calc(100% - 40px) 0, 100% 40px, 100% 100%, 40px 100%, 0 calc(100% - 40px));
  }
  .held__platzhalter {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem;
    background: repeating-linear-gradient(-45deg, var(--d-flaeche) 0 18px, #1d1d1d 18px 36px); border: 2px solid var(--akzent);
  }
  .held__platzhalter span { font-family: var(--d-titel); font-size: 6rem; line-height: 0.9; color: var(--akzent); }
  .held__platzhalter small { color: var(--d-leise); letter-spacing: 0.1em; text-transform: uppercase; }

  .inhalt { display: grid; gap: 3rem; margin-top: 4rem; }
  @media (min-width: 900px) { .inhalt { grid-template-columns: 1fr 1.2fr; } }
  .ueber p { font-size: 1.3rem; color: var(--d-sisal); margin: 0.75rem 0 2rem; }
  dl { margin: 0; display: grid; gap: 1px; background: var(--d-linie); border: 1px solid var(--d-linie); }
  dl div { background: var(--d-schwarz); padding: 1rem 1.25rem; }
  dt { font-family: var(--d-titel); letter-spacing: 0.12em; color: var(--d-leise); font-size: 1rem; }
  dd { margin: 0.2rem 0 0; font-size: 1.15rem; }
  h2 { font-size: clamp(2.8rem, 6vw, 4rem); margin: 0.5rem 0 1.25rem; }
  .spieler { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .spieler li { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 0.9rem 1.2rem; background: var(--d-flaeche); border-left: 6px solid var(--d-rot); }
  .inhalt--gruen .spieler li { border-left-color: var(--d-gruen); }
  .inhalt--gruen .d-label { color: var(--d-gruen); }
  .spieler__nr { font-family: var(--d-titel); font-size: 2rem; color: var(--d-leise); line-height: 1; }
  .spieler__name { font-weight: 700; font-size: 1.3rem; }
  .spieler__name em { font-weight: 500; color: var(--d-sisal); }
  .spieler__knopf { all: unset; cursor: pointer; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.4rem; font-weight: 700; font-size: 1.3rem; }
  .spieler__knopf:hover, .spieler__knopf:focus-visible { color: var(--d-rot); }
  .inhalt--gruen .spieler__knopf:hover { color: var(--d-gruen); }
  .spieler__knopf:focus-visible { outline: 2px solid var(--d-sisal); outline-offset: 4px; }
  .spieler__icon { font-family: var(--d-titel); font-size: 0.85rem; letter-spacing: 0.1em; color: var(--d-leise); font-weight: 400; }
  .spieler__hinweis { color: var(--d-leise); font-size: 1rem; margin-top: 0.9rem; }

  .steckbrief { padding: 0; border: 0; background: var(--d-flaeche); color: var(--d-text); width: min(58rem, calc(100vw - 2rem)); max-height: calc(100dvh - 2rem); border-top: 8px solid var(--d-rot); }
  .steckbrief--gruen { border-top-color: var(--d-gruen); }
  .steckbrief::backdrop { background: rgb(0 0 0 / 0.8); backdrop-filter: blur(4px); }
  .steckbrief__innen { display: grid; }
  @media (min-width: 760px) { .steckbrief__innen { grid-template-columns: 1fr 1fr; } }
  .steckbrief img { width: 100%; height: 100%; max-height: 80dvh; object-fit: contain; background: #000; }
  .steckbrief__text { padding: 1.75rem; }
  .steckbrief h3 { font-size: clamp(2.6rem, 6vw, 3.6rem); margin: 0.4rem 0 0.2rem; }
  .steckbrief__spitz { font-size: 1.4rem; font-style: italic; color: var(--d-sisal); margin: 0 0 1.5rem; }
  .steckbrief dl { background: transparent; border: 0; gap: 0.5rem; }
  .steckbrief dl div { background: var(--d-schwarz); }
  .steckbrief__zu { position: absolute; top: 0.6rem; right: 0.6rem; z-index: 1; width: 2.6rem; height: 2.6rem; border: 0; border-radius: 50%; background: rgb(0 0 0 / 0.7); color: #fff; font-size: 1.2rem; cursor: pointer; }
  .steckbrief__zu:hover { background: var(--d-rot); }
  .spieler__rolle { font-family: var(--d-titel); letter-spacing: 0.1em; font-size: 1rem; padding: 0.25rem 0.6rem 0.1rem; background: var(--d-sisal); color: var(--d-schwarz); }

  .weiter { margin-top: 4rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding-top: 2rem; border-top: 1px solid var(--d-linie); }
  .weiter p { margin: 0; font-family: var(--d-titel); font-size: 2rem; letter-spacing: 0.04em; }
</style>

<script>
  // Steckbrief-Fenster: Name anklicken öffnet, ✕ / Esc / Klick daneben schließt
  document.querySelectorAll<HTMLButtonElement>('[data-steckbrief]').forEach((knopf) => {
    const dialog = document.getElementById(knopf.dataset.steckbrief!) as HTMLDialogElement | null;
    if (!dialog) return;
    knopf.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('.steckbrief__zu')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>
