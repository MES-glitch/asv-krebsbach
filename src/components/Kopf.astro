---
import verein from '../data/verein.json';
import { url } from '../lib/utils';

const links = [
  { href: '/neuigkeiten/', text: 'Neuigkeiten' },
  { href: '/termine/', text: 'Termine' },
  { href: '/gewaesser/', text: 'Gewässer' },
  { href: '/jugend/', text: 'Jugend' },
  { href: '/verein/', text: 'Verein' },
  { href: '/mitgliedschaft/', text: 'Mitgliedschaft' },
];
const aktuell = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const istAktiv = (href: string) => (href === '/' ? aktuell === '/' : aktuell.startsWith(href.replace(/\/$/, '')));
---
<header class="kopf">
  <div class="container kopf__innen">
    <a class="marke" href={url('/')}>
      <img class="marke__logo" src={url('/logo.webp')} alt="" width="144" height="192" />
      <span class="marke__text">
        <span class="marke__name">{verein.name}</span>
        <span class="marke__unter">seit {verein.gruendungsjahr}</span>
      </span>
    </a>
    <details class="menue">
      <summary aria-label="Menü öffnen">
        <span class="menue__strich"></span><span class="menue__strich"></span><span class="menue__strich"></span>
      </summary>
      <nav aria-label="Hauptnavigation">
        <ul>
          {links.map((l) => (
            <li><a href={url(l.href)} aria-current={istAktiv(l.href) ? 'page' : undefined}>{l.text}</a></li>
          ))}
          <li class="nav__aufruf"><a class="knopf" href={url('/verein/#kontakt')}>Kontakt</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .kopf { background: rgb(255 250 242 / 0.92); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; border-bottom: 1px solid var(--rand); }
  .kopf__innen { display: flex; align-items: center; justify-content: space-between; min-height: 4.75rem; padding-top: 0.5rem; padding-bottom: 0.5rem; }
  .marke { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--text); }
  .marke__logo { height: 3.1rem; width: auto; }
  .marke__text { display: flex; flex-direction: column; line-height: 1.05; }
  .marke__name { font-family: var(--schrift-titel); font-weight: 700; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--blau-700); }
  .marke__unter { font-family: var(--schrift-titel); font-weight: 600; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-leise); }
  .menue summary { list-style: none; cursor: pointer; padding: 0.6rem; display: grid; gap: 5px; }
  .menue summary::-webkit-details-marker { display: none; }
  .menue__strich { display: block; width: 24px; height: 2px; background: var(--text); border-radius: 2px; }
  nav ul { list-style: none; margin: 0; padding: 0; }
  nav a:not(.knopf) {
    display: block; padding: 0.75rem 1rem; text-decoration: none; color: var(--text); border-radius: 999px;
    font-family: var(--schrift-titel); font-weight: 600; font-size: 1.1rem;
  }
  nav a:not(.knopf):hover { background: var(--blau-100); color: var(--blau-700); }
  nav a[aria-current='page'] { color: var(--blau-700); background: var(--blau-100); }
  .nav__aufruf { padding: 0.5rem 0 0; }

  @media (max-width: 959px) {
    nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--creme); border-bottom: 1px solid var(--rand); padding: 0.5rem 1rem 1.25rem; box-shadow: var(--schatten); }
  }
  @media (min-width: 960px) {
    .menue summary { display: none; }
    nav ul { display: flex; gap: 0.15rem; align-items: center; }
    nav a:not(.knopf) { padding: 0.45rem 0.9rem; font-size: 1.05rem; }
    .nav__aufruf { padding: 0 0 0 0.75rem; }
  }
</style>

<script>
  // Auf großen Bildschirmen ist das Menü immer offen.
  const menue = document.querySelector<HTMLDetailsElement>('.menue');
  const mq = window.matchMedia('(min-width: 960px)');
  const setzen = () => { if (menue) menue.open = mq.matches; };
  setzen();
  mq.addEventListener('change', setzen);
</script>
