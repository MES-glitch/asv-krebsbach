---
import verein from '../data/verein.json';
import { url } from '../lib/utils';

const links = [
  { href: '/', text: 'Start' },
  { href: '/neuigkeiten/', text: 'Neuigkeiten' },
  { href: '/termine/', text: 'Termine' },
  { href: '/gewaesser/', text: 'Gewässer' },
  { href: '/mitgliedschaft/', text: 'Mitgliedschaft' },
  { href: '/verein/', text: 'Verein & Kontakt' },
];
const aktuell = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const istAktiv = (href: string) => (href === '/' ? aktuell === '/' : aktuell.startsWith(href.replace(/\/$/, '')));
---
<header class="kopf">
  <div class="container kopf__innen">
    <a class="marke" href={url('/')}>
      <img class="marke__logo" src={url('/logo.webp')} alt="Wappen des ASV Krebsbach" width="143" height="192" />
      <span>{verein.name}</span>
    </a>
    <details class="menue">
      <summary aria-label="Menü öffnen">
        <span class="menue__strich"></span><span class="menue__strich"></span><span class="menue__strich"></span>
      </summary>
      <nav aria-label="Hauptnavigation">
        <ul>
          {links.map((l) => (
            <li><a href={url(l.href)} aria-current={istAktiv(l.href) ? 'page' : undefined}>{l.text}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .kopf { background: var(--weiss); border-bottom: 1px solid var(--rand); position: sticky; top: 0; z-index: 10; }
  .kopf__innen { display: flex; align-items: center; justify-content: space-between; min-height: 4.5rem; padding-top: 0.4rem; padding-bottom: 0.4rem; }
  .marke { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.25rem; color: var(--blau-900); }
  .marke__logo { height: 3rem; width: auto; }
  .menue summary { list-style: none; cursor: pointer; padding: 0.6rem; display: grid; gap: 5px; }
  .menue summary::-webkit-details-marker { display: none; }
  .menue__strich { display: block; width: 24px; height: 2px; background: var(--blau-900); border-radius: 2px; }
  nav ul { list-style: none; margin: 0; padding: 0; }
  nav a { display: block; padding: 0.75rem 1rem; text-decoration: none; color: var(--text); font-weight: 500; border-radius: 8px; }
  nav a:hover { background: var(--blau-100); color: var(--blau-900); }
  nav a[aria-current='page'] { color: var(--blau-700); background: var(--blau-100); }

  @media (max-width: 899px) {
    nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--weiss); border-bottom: 1px solid var(--rand); padding: 0.5rem 1rem 1rem; box-shadow: var(--schatten); }
  }
  @media (min-width: 900px) {
    .menue summary { display: none; }
    .menue > nav { display: block; }
    nav ul { display: flex; gap: 0.25rem; }
    nav a { padding: 0.5rem 0.8rem; font-size: 0.95rem; }
  }
</style>

<script>
  // Auf großen Bildschirmen ist das Menü immer offen.
  const menue = document.querySelector<HTMLDetailsElement>('.menue');
  const mq = window.matchMedia('(min-width: 900px)');
  const setzen = () => { if (menue) menue.open = mq.matches; };
  setzen();
  mq.addEventListener('change', setzen);
</script>
