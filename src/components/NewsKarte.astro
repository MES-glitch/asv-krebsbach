---
import type { CollectionEntry } from 'astro:content';
import { url, datumLang } from '../lib/utils';

interface Props {
  eintrag: CollectionEntry<'neuigkeiten'>;
}
const { eintrag } = Astro.props;
const { titel, datum, kurztext, bild } = eintrag.data;
---
<article class="news karte">
  {bild ? <img src={url(bild)} alt="" loading="lazy" /> : <div class="news__platzhalter" aria-hidden="true" />}
  <div class="news__inhalt">
    <time class="leise" datetime={datum.toISOString().slice(0, 10)}>{datumLang(datum)}</time>
    <h3><a href={url(`/neuigkeiten/${eintrag.id}/`)}>{titel}</a></h3>
    {kurztext && <p>{kurztext}</p>}
  </div>
</article>

<style>
  .news { overflow: hidden; display: flex; flex-direction: column; position: relative; }
  .news img, .news__platzhalter { aspect-ratio: 16 / 9; width: 100%; object-fit: cover; }
  .news__platzhalter { background: linear-gradient(135deg, var(--blau-500), var(--schilf-600)); opacity: 0.85; }
  .news__inhalt { padding: 1rem 1.25rem 1.25rem; }
  .news time { font-size: 0.85rem; }
  .news h3 { margin: 0.3rem 0 0.4rem; }
  .news h3 a { text-decoration: none; color: var(--blau-900); }
  .news h3 a::after { content: ''; position: absolute; inset: 0; }
  .news:hover h3 a { color: var(--blau-500); }
  .news p { margin: 0; color: var(--text-leise); }
</style>
