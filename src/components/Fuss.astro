---
import verein from '../data/verein.json';
import { url } from '../lib/utils';
const jahr = new Date().getFullYear();
---
<footer class="fuss">
  <div class="container fuss__innen">
    <div class="fuss__marke">
      <img src={url('/logo.webp')} alt="" width="144" height="192" />
      <div>
        <strong>{verein.vollerName}</strong>
        <p class="fuss__orte">Gegründet {verein.gruendungsjahr} · {verein.orte.join(' · ')}</p>
      </div>
    </div>
    <div>
      <p class="fuss__titel">Kontakt</p>
      <p set:html={verein.anschrift.replace(/\n/g, '<br />')} />
      {verein.email && <p><a href={`mailto:${verein.email}`}>{verein.email}</a></p>}
    </div>
    <nav aria-label="Weitere Seiten">
      <p class="fuss__titel">Verein</p>
      <a href={url('/jugend/')}>Jugendabteilung</a>
      <a href={url('/mitgliedschaft/')}>Mitgliedschaft</a>
      <a href={url('/termine/')}>Termine</a>
      <a href={url('/impressum/')}>Impressum</a>
      <a href={url('/datenschutz/')}>Datenschutz</a>
    </nav>
  </div>
  <div class="container fuss__unten">© {jahr} {verein.vollerName}</div>
</footer>

<style>
  .fuss { background: var(--blau-900); color: rgb(255 255 255 / 0.85); padding: 3.5rem 0 1.5rem; margin-top: 4rem; border-radius: 40px 40px 0 0; }
  .fuss a { color: var(--weiss); text-decoration: none; }
  .fuss a:hover { text-decoration: underline; color: var(--weiss); }
  .fuss__innen { display: grid; gap: 2rem; }
  @media (min-width: 800px) { .fuss__innen { grid-template-columns: 2fr 1fr 1fr; } }
  .fuss__marke { display: flex; gap: 1rem; align-items: flex-start; }
  .fuss__marke img { width: 3.5rem; height: auto; flex: none; }
  .fuss strong { font-family: var(--schrift-titel); font-size: 1.3rem; color: var(--weiss); }
  .fuss p { margin: 0.3rem 0 0; }
  .fuss__orte { font-size: 0.95rem; opacity: 0.75; }
  .fuss__titel { font-family: var(--schrift-titel); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; margin: 0 0 0.4rem !important; }
  .fuss nav { display: flex; flex-direction: column; gap: 0.3rem; }
  .fuss__unten { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: 0.9rem; opacity: 0.6; }
</style>
