---
import type { CollectionEntry } from 'astro:content';
import { tag, monat, datumKurz } from '../lib/utils';

interface Props {
  termine: CollectionEntry<'termine'>[];
}
const { termine } = Astro.props;
---
<ul class="termine">
  {termine.map((t) => (
    <li class="termin karte">
      <div class="termin__datum" aria-hidden="true">
        <span class="termin__tag">{tag(t.data.datum)}</span>
        <span class="termin__monat">{monat(t.data.datum)}</span>
      </div>
      <div class="termin__info">
        <span class={`etikett etikett--${t.data.kategorie.toLowerCase()}`}>{t.data.kategorie}</span>
        {t.data.nurMitglieder && <span class="etikett">nur Mitglieder</span>}
        <h3>{t.data.titel}</h3>
        <p class="leise">
          {datumKurz(t.data.datum)}{t.data.bis && ` – ${datumKurz(t.data.bis)}`}
          {t.data.uhrzeit && ` · ${t.data.uhrzeit} Uhr`}
          {t.data.ort && ` · ${t.data.ort}`}
        </p>
        {t.body?.trim() && <p class="termin__text">{t.body.trim()}</p>}
      </div>
    </li>
  ))}
</ul>

<style>
  .termine { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; }
  .termin { display: flex; gap: 1.1rem; padding: 1rem 1.1rem; align-items: flex-start; background: var(--weiss); box-shadow: none; border: 1px solid var(--rand); }
  .termin__datum { flex: none; width: 4.25rem; text-align: center; background: var(--blau-700); border-radius: 16px; padding: 0.55rem 0; color: var(--weiss); font-family: var(--schrift-titel); }
  .termin__tag { display: block; font-size: 1.9rem; font-weight: 700; line-height: 1; }
  .termin__monat { display: block; font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.85; }
  .termin__info { min-width: 0; }
  .termin h3 { font-size: 1.35rem; margin: 0.35rem 0 0.15rem; overflow-wrap: break-word; hyphens: auto; }
  .termin p { margin: 0; }
  .termin__text { margin-top: 0.4rem !important; white-space: pre-line; }
  .etikett { display: inline-block; font-family: var(--schrift-titel); font-size: 0.85rem; font-weight: 600; padding: 0.1rem 0.55rem; border-radius: 999px; background: #efeff4; color: var(--text-leise); margin-right: 0.3rem; }
  .etikett--arbeitseinsatz { background: #fdf0dc; color: #8a5a12; }
  .etikett--hegefischen { background: #e0f2f1; color: #0f6e6a; }
  .etikett--versammlung { background: var(--blau-100); color: var(--blau-700); }
  .etikett--veranstaltung { background: var(--schilf-100); color: var(--schilf-800); }
</style>
