---
// Zeigt ein Foto – oder, solange noch keins hochgeladen ist, einen gut sichtbaren Platzhalter.
import { url } from '../lib/utils';

interface Props {
  bild?: string;
  alt?: string;
  platzhalter: string;
  form?: 'blatt' | 'blatt-gespiegelt' | 'tropfen' | 'rund';
  farbe?: 'schilf' | 'blau' | 'koralle' | 'sonne';
  class?: string;
  laden?: 'lazy' | 'eager';
}
const { bild, alt = '', platzhalter, form = 'rund', farbe = 'schilf', class: klasse = '', laden = 'lazy' } = Astro.props;
---
{bild ? (
  <img class:list={['foto', `form-${form}`, klasse]} src={url(bild)} alt={alt} loading={laden} />
) : (
  <div class:list={['foto', 'foto--platzhalter', `foto--${farbe}`, `form-${form}`, klasse]} role="img" aria-label={`Platzhalter: ${platzhalter}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /><circle cx="12" cy="13" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    <span>{platzhalter}</span>
  </div>
)}

<style>
  .foto { width: 100%; height: 100%; object-fit: cover; display: block; }
  .foto--platzhalter {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
    text-align: center; padding: 1rem; font-family: var(--schrift-titel); font-weight: 600; font-size: 0.95rem;
    background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.18) 0 12px, transparent 12px 24px);
  }
  .foto--platzhalter svg { width: 2rem; height: 2rem; opacity: 0.8; }
  .foto--schilf { background-color: var(--schilf-300); color: var(--schilf-800); }
  .foto--blau { background-color: var(--blau-300); color: var(--blau-900); }
  .foto--koralle { background-color: #f5b9a3; color: var(--koralle-800); }
  .foto--sonne { background-color: var(--sonne-300); color: var(--sonne-800); }
</style>
